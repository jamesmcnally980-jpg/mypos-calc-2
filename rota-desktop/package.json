{
  "name": "venue-rota-maker",
  "version": "1.0.0",
  "description": "Venue Rota Maker desktop app",
  "main": "main.js",
  "author": "James McNally",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.venue.rotamaker",
    "productName": "Venue Rota Maker",
    "files": ["main.js", "index.html"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
